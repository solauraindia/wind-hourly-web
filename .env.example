# irec database — read-only role; device master data, actuals, issuances
IREC_DATABASE_URL=

# App database (separate Neon project): device mappings + hourly values
DATABASE_URL=

# Neon Auth (managed Better Auth) on the app project
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=   # openssl rand -base64 32

# Optional: comma-separated emails allowed in (empty = any existing Neon Auth account)
ALLOWED_EMAILS=
